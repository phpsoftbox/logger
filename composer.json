{
    "name": "phpsoftbox/logger",
    "description": "Logger component for the PhpSoftBox HTTP framework",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Anton K.",
            "email": "inspector-who@mail.ru"
        }
    ],
    "config": {
        "sort-packages": true
    },
    "require": {
        "php": "^8.5",
        "psr/log": "^3.0",
        "psr/http-message": "^2.0",
        "psr/http-server-handler": "^1.0",
        "psr/http-server-middleware": "^1.0"
    },
    "require-dev": {
        "phpsoftbox/cs-fixer": "^1.2.1",
        "phpsoftbox/http-message": "dev-master",
        "phpunit/phpunit": "^13.3"
    },
    "provide": {
        "psr/log-implementation": "3.0.0"
    },
    "autoload": {
        "psr-4": {
            "PhpSoftBox\\Logger\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PhpSoftBox\\Logger\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "cs:fix": "vendor/bin/psb-cs-fixer fix",
        "cs:check": "vendor/bin/psb-cs-fixer check --diff"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
